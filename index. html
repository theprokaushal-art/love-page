<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>A tiny question 💖</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      overflow: hidden;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #ffd6e7, #ffeef5);
      color: #4b1730;
    }

    .card {
      width: min(90%, 520px);
      padding: 48px 28px;
      text-align: center;
      background: rgba(255, 255, 255, 0.8);
      border-radius: 28px;
      box-shadow: 0 16px 45px rgba(157, 29, 86, 0.18);
    }

    h1 {
      font-size: clamp(2rem, 6vw, 3.2rem);
      margin: 0 0 35px;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 22px;
      position: relative;
      min-height: 70px;
    }

    button {
      border: none;
      border-radius: 999px;
      padding: 15px 34px;
      color: white;
      font-size: 1.1rem;
      font-weight: bold;
      cursor: pointer;
      transition: transform 0.18s ease, background 0.18s ease;
    }

    #yesBtn {
      background: #e73874;
    }

    #yesBtn:hover {
      background: #c91f5d;
      transform: scale(1.08);
    }

    #noBtn {
      position: fixed;
      background: #777;
      z-index: 10;
    }

    .hint {
      margin-top: 28px;
      color: #8f4565;
    }
  </style>
</head>

<body>
  <main class="card">
    <h1>Do you love me? 💕</h1>

    <div class="buttons">
      <button id="yesBtn">Yes ❤️</button>
      <button id="noBtn">No</button>
    </div>

    <p class="hint">Choose carefully 😄</p>
  </main>

  <script>
    const noBtn = document.getElementById("noBtn");
    const yesBtn = document.getElementById("yesBtn");

    function moveNoButton() {
      const padding = 20;
      const maxX = window.innerWidth - noBtn.offsetWidth - padding;
      const maxY = window.innerHeight - noBtn.offsetHeight - padding;

      const randomX = Math.max(padding, Math.random() * maxX);
      const randomY = Math.max(padding, Math.random() * maxY);

      noBtn.style.left = randomX + "px";
      noBtn.style.top = randomY + "px";
    }

    // Start the No button somewhere visible
    moveNoButton();

    // Move before it can be clicked or tapped
    noBtn.addEventListener("mouseenter", moveNoButton);
    noBtn.addEventListener("touchstart", (event) => {
      event.preventDefault();
      moveNoButton();
    });

    // Replace this URL with the Instagram profile you want
    yesBtn.addEventListener("click", () => {
      window.location.href ="https://www.instagram.com/n1sab3lg/";
    });

    window.addEventListener("resize", moveNoButton);
  </script>
</body>
</html>
from flask import Flask, render_template

app = Flask(__name__)

@app.route("/")
def home():
    return render_template("index.html")

if __name__ == "__main__":
    app.run(debug=True)
